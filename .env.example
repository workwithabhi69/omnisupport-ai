# =======================================================
# Multilingual E-Commerce Customer Support Chatbot Config
# =======================================================

# Ollama Local LLM Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:0.5b

# Multilingual Embeddings Model
# Default: intfloat/multilingual-e5-small (lightweight 384-dim, fast CPU inference)
# Alternative: BAAI/bge-m3
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Vector Database Path (relative to project root or absolute)
VECTOR_STORE_DIR=vector_store
CHROMA_COLLECTION=ecommerce_knowledge_base

# RAG Search Parameters
TOP_K_CHUNKS=4
SIMILARITY_THRESHOLD=0.80

# SQLite Conversation Persistence
SQLITE_DB_PATH=data/chat_history.db
